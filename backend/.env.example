APP_NAME="MarketLens AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
API_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# SQLite for local development (zero setup)
DATABASE_URL="sqlite:///./marketlens.db"

# PostgreSQL production example (uncomment when deploying)
# DATABASE_URL="postgresql+psycopg2://marketlens_user:strong_password@localhost:5432/marketlens_db"

# Comma-separated allowed origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
