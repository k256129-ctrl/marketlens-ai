{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "routePrefix": "/api"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "routePrefix": "/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}